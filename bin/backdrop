#!/bin/sh
# backdrop -- render a bounded, SHARP copy of Omarchy's current wallpaper.
#
# Prints "new" when it wrote a fresh copy, "cached" when the existing one is
# still current, and nothing at all when it declined to do the work.
#
# WHY A HELPER RENDERS THE PIXELS, rather than QML loading the wallpaper:
# a check that ends before the read cannot bind what the read consumes. The
# wallpaper link -- and whatever it points at -- can be replaced between the
# two. So this never hands QML a pathname it has to trust. It decodes the
# untrusted bytes HERE, in a short-lived process under explicit resource
# limits, and writes a small JPEG that the plugin owns. QML opens only that.
#
# A hostile target therefore costs this process, not the shell it would
# otherwise have stalled: a FIFO, a device node, a decompression bomb or a
# 5-gigapixel canvas hits `timeout` and ImageMagick's own -limit values, and
# the plugin simply keeps whatever backdrop it had.

set -eu

export PATH=/usr/bin:/bin
export LC_ALL=C

link="${HOME:?}/.local/state/omarchy/current/background"

# $XDG_RUNTIME_DIR, not a cache under $HOME, and not by accident: the
# marketplace's scanner raises `home-write` for a plugin writing anywhere in
# $HOME outside ~/.config/omarchy/plugins/, and that is a blocking finding
# rather than a queue. The runtime directory is also the better home for this
# on its own merits -- it is tmpfs, it is cleared at logout, and rebuilding the
# backdrop costs about 60 ms, so there is nothing worth surviving a reboot.
#
# No fallback into $HOME. If there is no runtime directory this declines to do
# anything and the plugin keeps its bundled backdrop.
[ -n "${XDG_RUNTIME_DIR:-}" ] || exit 0
dir="$XDG_RUNTIME_DIR/omarchy-launchpad"
out="$dir/backdrop.jpg"
id_file="$dir/backdrop.id"

# -f follows the link and is false for a FIFO, socket, device or directory.
target=$(readlink -f "$link" 2>/dev/null) || exit 0
[ -n "$target" ] || exit 0
[ -f "$target" ] || exit 0

size=$(stat -c %s "$target" 2>/dev/null) || exit 0
[ "$size" -gt 0 ] || exit 0
[ "$size" -le 67108864 ] || exit 0

# Identity is size plus name: either changes when the wallpaper does, and
# neither is a pathname anything downstream will open.
id="$size $(basename -- "$target")"

if [ -f "$out" ] && [ -f "$id_file" ] && [ "$(cat "$id_file" 2>/dev/null)" = "$id" ]; then
  printf 'cached\n'
  exit 0
fi

# Say so BEFORE doing the work. Rendering a 5K wallpaper takes a few hundred
# milliseconds, and the overlay is already on screen by then -- without this
# line it would spend that time showing the PREVIOUS wallpaper, which is worse
# than showing nothing of the user's at all. The caller drops back to its own
# bundled backdrop the moment it reads this, and the new render fades in when
# it arrives.
printf 'stale\n'

mkdir -p "$dir"
# The temporary name ends in the pid, so it carries no extension ImageMagick
# could read a format out of -- hence the explicit `jpeg:` prefix on the output
# below. Without it the encoder picks for itself, and it was picking WebP.
tmp="$out.$$"

# [0] takes the first frame only, so a multi-frame file cannot multiply the
# work. The -limit values and the timeout bound everything else.
#
# NO BLUR HERE, on purpose. This used to hand QML a finished blurred pane,
# which is cheap but fixed: the only thing left to animate was how dark it was,
# so the overlay arrived with the blur already at full strength and then dimmed
# -- the blur appeared, it never gathered. The compositor's own blur has the
# same problem for the same reason; a layer is blurred or it is not, there is
# no half. Handing over a sharp copy is what puts the radius in the plugin's
# hands, where it can be run from nothing up to full over the length of the
# opening and back down on the way out.
#
# 1280x800 because the result is going to be blurred into mush a few hundred
# milliseconds later: it only has to hold up for the first frames, while it is
# still nearly transparent and barely blurred. `jpeg:size` lets libjpeg scale
# during decode, so a 5K wallpaper never arrives at full size in memory.
#
# No -modulate either. Darkening belongs to the tint the plugin draws on top,
# where it is one number in one place rather than baked into the pixels.
if timeout 15 magick \
      -limit memory 256MiB -limit map 256MiB -limit disk 512MiB -limit time 12 \
      -define jpeg:size=1280x800 \
      "$target[0]" -auto-orient \
      -resize 1280x800^ -gravity center -extent 1280x800 \
      -quality 82 "jpeg:$tmp" 2>/dev/null
then
  # Atomic: QML can never see a half-written file.
  mv -f "$tmp" "$out"
  printf '%s\n' "$id" > "$id_file"
  printf 'new\n'
else
  rm -f "$tmp"
  exit 0
fi
